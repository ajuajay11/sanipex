document.querySelectorAll('.custom-option').forEach(option => {
        option.addEventListener('click', function() {
            
            let value = this.getAttribute('data-value');
            let text = this.textContent;
            let imgSrc = this.querySelector('img').getAttribute('src');

            
            let trigger = this.closest('.custom-select').querySelector('.custom-select-trigger');
            let optionsContainer = this.closest('.custom-select-options');

            
            trigger.innerHTML = '';

            
            let img = document.createElement('img');
            img.setAttribute('src', imgSrc);
            img.style.marginRight = '10px'; 
            img.style.width = '20px'; 
            img.style.height = '20px'; 

            
            trigger.appendChild(img);
            trigger.appendChild(document.createTextNode(text));

            
            optionsContainer.classList.remove('open');
        });
    });
