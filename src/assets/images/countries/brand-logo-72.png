document.addEventListener('DOMContentLoaded', function() {
        function handleHover(itemId, contentId) {
            const item = document.getElementById(itemId);
            const content = document.getElementById(contentId);
            if (!item || !content) {
                console.warn("Missing element for:", itemId, contentId);
                return;
            }

            item.addEventListener('mouseenter', function() {
                document.querySelectorAll('.main-categories').forEach(li => li.classList.remove('active'));
                document.querySelectorAll('.megamenu .right .content').forEach(div => div.classList.remove('active-content'));
                this.classList.add('active');
                content.classList.add('active-content');
                if (typeof amlazycallback !== 'undefined') {
                    amlazycallback();
                }
            });
        }
         handleHover('bathroom_bathroom', 'bathroom_bathroom-content');
