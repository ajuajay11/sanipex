        $(document).ready(function() {
            $(".product-item-photo").each(function() {
                let firstimage_photo_src = $(this).find(".product-first-image-photo").attr("src");
                let firstimage_photo_datasrc = $(this).find(".product-first-image-photo").attr("data-src");

                let secondimage_photo_src = $(this).find(".product-second-image-photo").attr("src");
                let secondimage_photo_datasrc = $(this).find(".product-second-image-photo").attr("data-src");

                $(this).find(".product-first-image-photo").attr("src", secondimage_photo_src);
                $(this).find(".product-first-image-photo").attr("data-src", secondimage_photo_datasrc);

                $(this).find(".product-second-image-photo").attr("src", firstimage_photo_src);
                $(this).find(".product-second-image-photo").attr("data-src", firstimage_photo_datasrc);

            });
        });
    });
require(['jquery', 'owl.carousel'], function($) {
        $(document).ready(function() {
            $('#brands-carousel').owlCarousel({
                checkVisible: true,
                lazyLoad: true,
                items: 5,
