document.addEventListener('DOMContentLoaded', function() {
        var viewMoreBtn = document.querySelector('.view-more-button');
        var viewLessBtn = document.querySelector('.view-less-button');
        var extraCategories = document.querySelectorAll('.extra-category');
        var categoryContainer = document.querySelector('.category');

        function handleViewLess() {
            extraCategories.forEach(function(cat) {
                cat.style.display = 'none';
            });
            viewMoreBtn.style.display = 'flex';
            viewLessBtn.style.display = 'none';
        }

        if (window.matchMedia("(min-width: 769px)").matches) {
            extraCategories.forEach(function(cat) {
                cat.style.display = 'flex';
            });
            viewMoreBtn.style.display = 'none';
            viewLessBtn.style.display = 'flex';
        } else {
            handleViewLess();
        }


        viewMoreBtn.addEventListener('click', function() {
            extraCategories.forEach(function(cat) {
                cat.style.display = 'flex';
            });
            viewMoreBtn.style.display = 'none';
            viewLessBtn.style.display = 'flex';
        });

        viewLessBtn.addEventListener('click', function() {
            handleViewLess();

            var offsetPosition = categoryContainer.getBoundingClientRect().top + window.pageYOffset - 100;
            window.scrollTo({
                top: offsetPosition,
                behavior: "smooth"
            });
        });
    });


