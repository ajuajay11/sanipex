document.addEventListener("DOMContentLoaded", function() {
        const cards = document.querySelectorAll('.category-card');
        const isMobile = window.innerWidth <= 767;

        
        if (isMobile && cards.length > 4) {
            cards.forEach((card, index) => {
                if (index >= 4) {
                    card.classList.add('extra-category');
                    card.style.display = 'none';
                }
            });

            const viewToggleWrapper = document.querySelector('.view-toggle-wrapper');
            const moreBtn = viewToggleWrapper.querySelector('.view-more-button');
            const lessBtn = viewToggleWrapper.querySelector('.view-less-button');

            moreBtn.style.display = 'inline-block';
            lessBtn.style.display = 'none';

            moreBtn.addEventListener('click', () => {
                document.querySelectorAll('.extra-category').forEach(el => el.style.display = 'flex');
                moreBtn.style.display = 'none';
                lessBtn.style.display = 'inline-block';
            });

            lessBtn.addEventListener('click', () => {
                document.querySelectorAll('.extra-category').forEach(el => el.style.display = 'none');
                moreBtn.style.display = 'inline-block';
                lessBtn.style.display = 'none';
            });
        } else {
            
            const viewToggleWrapper = document.querySelector('.view-toggle-wrapper');
            if (viewToggleWrapper) {
                viewToggleWrapper.style.display = 'none';
            }
        }
    });
document.addEventListener('DOMContentLoaded', () => {
    const isMobile = window.innerWidth <= 768;
    const isProductPage = document.body.classList.contains('catalog-product-view');

    
    
    if (!isMobile || (isMobile && isProductPage)) {
        setTimeout(() => {
            if (!document.querySelector('script[src*="sanipexgroup.js"]')) {
                const script = document.createElement('script');
                script.src = 'https://cdn.roomvo.com/static/scripts/b2b/sanipexgroup.js';
                script.async = true;
                script.onerror = () => console.warn('Failed to load Roomvo script');
                document.head.appendChild(script);
            }
        }, 3000);
    }
});


window.addEventListener('resize', () => {
    const isMobile = window.innerWidth <= 768;
    const isProductPage = document.body.classList.contains('catalog-product-view');
    const scriptExists = document.querySelector('script[src*="sanipexgroup.js"]');

    
    if (isMobile && !isProductPage && scriptExists) {
        scriptExists.remove();
    }

    
    if (!isMobile && !scriptExists) {
        setTimeout(() => {
            const script = document.createElement('script');
            script.src = 'https://cdn.roomvo.com/static/scripts/b2b/sanipexgroup.js';
            script.async = true;
            document.head.appendChild(script);
        }, 1000);
    }
});
require(["jquery"], function($) {
        $(document).ready(function() {
            var $containers = $('.container, .container-fluid, .post-content, .blog-grid, section');

            function checkVisibility() {
                $containers.each(function() {
                    var $fadeInElements = $(this).find('.fade-in');
                    $fadeInElements.each(function(index) {
                        var delay = index * 100; // delay for each item based on its index

                        var elementTop = $(this).offset().top - 110;
                        var elementBottom = elementTop + $(this).outerHeight();
                        var viewportTop = $(window).scrollTop();
                        var viewportBottom = viewportTop + $(window).height();

                        if (elementBottom > viewportTop && elementTop < viewportBottom && !$(this).hasClass('is-visible')) {
                            $(this).css('transition-delay', delay + 'ms').addClass('is-visible');
                        }
                    });
                });

                if ($('.fade-in:not(.is-visible)').length === 0) {
                    $(window).off('scroll', checkVisibility);
                }
            }

            $(window).on('scroll', checkVisibility);
            checkVisibility();
        });
    });
document.addEventListener('DOMContentLoaded', (event) => {
    document.querySelectorAll('.product.attribute.sku').forEach(item => {
        item.style.position = 'relative'; 
        item.addEventListener('click', function() {
            const tempInput = document.createElement('input');
            tempInput.value = this.innerText; 
            document.body.appendChild(tempInput);
            tempInput.select(); 
            document.execCommand('copy'); 
            document.body.removeChild(tempInput); 

            alert('SKU copied: ' + tempInput.value);
        });
    });
